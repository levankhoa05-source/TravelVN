<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vivu_bg_gray"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarExplore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vivu_surface"
        android:elevation="2dp"
        app:navigationIcon="@drawable/baseline_arrow_back_24"
        app:title="@string/feature_explore"
        app:titleTextColor="@color/vivu_black" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:text="@string/explore_hint"
        android:textColor="@color/vivu_text_gray"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExplore"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingBottom="16dp" />
</LinearLayout>
